# ============================================================
# Stage 1: Build Stage (Maven + OpenJDK 21)
# ============================================================
FROM maven:3.9.9-eclipse-temurin-21 AS builder

WORKDIR /build

# Copy Maven descriptor and download dependencies for faster layer caching
COPY pom.xml .
RUN mvn dependency:go-offline -B || true

# Copy source code and build production package
COPY src ./src
RUN mvn clean package -DskipTests -B

# ============================================================
# Stage 2: Runtime Stage (Lightweight JRE 21)
# ============================================================
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create a non-root group and user for security
RUN addgroup -S nirmaansetu && adduser -S nirmaansetu -G nirmaansetu

# Copy generated Spring Boot executable JAR from builder
COPY --from=builder /build/target/nirmaansetu-*.jar app.jar

# Fix permissions
RUN chown -R nirmaansetu:nirmaansetu /app

USER nirmaansetu

# Default port fallback (Vercel overrides PORT automatically)
ENV PORT=8080
ENV SPRING_PROFILES_ACTIVE=dev

EXPOSE 8080

# Execute Spring Boot using Vercel's provided PORT and bind to 0.0.0.0
ENTRYPOINT ["sh", "-c", "exec java -Djava.security.egd=file:/dev/./urandom -Dserver.port=${PORT:-8080} -Dserver.address=0.0.0.0 -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-dev} -jar app.jar"]
