# ============================================================
# NirmaanSetu Frontend Environment Variables (Vite)
# ============================================================

# Base URL for API requests. Defaults to relative '/api'
# In Vercel and production, keep it empty or '/api' to use same-origin routing.
VITE_API_BASE_URL=/api

# Local development backend URL (used by Vite proxy in vite.config.ts)
VITE_BACKEND_URL=http://localhost:8080
